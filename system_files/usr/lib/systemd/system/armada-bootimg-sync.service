[Unit]
Description=Rebuild the ABL boot.img for the next-boot deployment before reboot
ConditionPathExists=/run/ostree-booted
# SM8550-family only. This rebuilds the ESP /KERNEL Android boot.img that the
# ABL boots directly; the SDM845 AYN Odin instead boots ABL->U-Boot->GRUB->BLS
# and never reads /boot/efi/KERNEL. On the Odin armada-bootimg-update also fails
# (its assembled cmdline exceeds the 512B header-v0 limit), and the ExecStop
# `|| bootc rollback` then reverts every bootc upgrade on shutdown. Gate off on
# sdm845 via the modem remoteproc marker (present on the Odin, absent on SM8550),
# the negation of the sdm845 Wi-Fi units' ConditionPathExists.
ConditionPathExists=!/sys/bus/platform/devices/4080000.remoteproc
DefaultDependencies=no
RequiresMountsFor=/sysroot /boot /boot/efi
# Reverse stop order: ordered before finalize so our ExecStop runs after it,
# against the finalized next-boot deployment.
After=local-fs.target systemd-journal-flush.service
Before=ostree-finalize-staged.service final.target
Conflicts=final.target

[Service]
Type=oneshot
RemainAfterExit=yes
# No-op start so the oneshot activates and its ExecStop fires at shutdown.
ExecStart=/bin/true
# Keep manual rollback and other non-staged BLS changes in sync. Staged-update
# failure handling belongs to the OSTree finalization hook.
ExecStop=/usr/libexec/armada/armada-bootimg-update

[Install]
WantedBy=multi-user.target
